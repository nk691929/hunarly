# Copy to .env.local:  cp .env.example .env.local   (PowerShell: Copy-Item .env.example .env.local)
# Every variable is validated in src/config/env.ts.
# The site works without anything below except NEXT_PUBLIC_SITE_URL: it runs in guest mode
# (builder with drafts saved in the browser). Fill in the Accounts section to turn on sign-in.

# --- Site ---------------------------------------------------------------------------------
# Public URL of the site. Used for canonical URLs, sitemap and Open Graph.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Accounts (all three groups are needed together; see docs/auth-and-database.md) --------
# PostgreSQL connection string. Local Docker (docker compose up -d):
#   postgresql://hunarly:hunarly@localhost:5432/hunarly
# Neon or Supabase: copy the connection string from their dashboard.
DATABASE_URL=

# Secret used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google sign-in (optional). Create OAuth credentials in Google Cloud Console and add the
# redirect URI  http://localhost:3000/api/auth/callback/google  (and your production URL).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email sign-in links via Resend (optional in development: without these, the sign-in link is
# printed in the terminal running `pnpm dev`). In production both are required.
RESEND_API_KEY=
# Sender shown on the email, for example: Hunarly <login@your-domain.com>
EMAIL_FROM=

# --- PDF export ---------------------------------------------------------------------------
# PDF export opens the app's own /print page in a headless browser. Install the browser once:
#   pnpm exec playwright install chromium
# If the app runs somewhere other than NEXT_PUBLIC_SITE_URL (for example port 3001), set it here.
PDF_BASE_URL=

# Development only. Set to 1 to export PDFs without the free-plan watermark.
DEV_PRO_UNLOCK=

# Set to 1 to skip env validation (CI builds that do not need real values).
# SKIP_ENV_VALIDATION=1
